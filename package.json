{
  "name": "revision-planner",
  "private": true,
  "version": "2.0.0",
  "description": "Planificateur de revisions pour etudiants : saisie des examens et generation automatique d'un planning par repetition espacee.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run develop --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo:capture": "node scripts/capture-demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "playwright": "^1.49.1"
  }
}
